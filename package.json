{
  "name": "zhaojian-photo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "照见 Photo Agent V1 modular monolith and generation worker",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node scripts/prepare-test-database.mjs && node --test --test-concurrency=1 test-integration/*.test.mjs",
    "test:session": "node scripts/prepare-test-database.mjs && node --test --test-concurrency=1 test-integration/session-storage-*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "db:up": "docker compose up -d postgres",
    "dev:up": "docker compose up -d postgres minio",
    "db:down": "docker compose down",
    "dev:down": "docker compose down",
    "db:migrate": "node src/infrastructure/postgres/migrate.mjs",
    "start:api": "node src/api/main.mjs",
    "start:worker": "node src/worker/main.mjs",
    "seed:smoke": "node --env-file=.env scripts/seed-smoke.mjs",
    "smoke:image": "node --env-file=.env scripts/smoke-image.mjs",
    "smoke:agent": "node --env-file=.env scripts/smoke-agent.mjs",
    "smoke:api": "node --env-file=.env scripts/smoke-api.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1115.0",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "pg": "^8.16.3"
  }
}
