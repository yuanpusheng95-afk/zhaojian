{
  "name": "zhaojian-photo-agent",
  "version": "0.1.0",
  "private": true,
  "description": "照见 Photo Agent V1 modular monolith and generation worker",
  "scripts": {
    "test": "bun test test/",
    "test:integration": "bun run scripts/prepare-test-database.mjs && bun --env-file=.env.test test test-integration/",
    "check": "tsc --noEmit",
    "db:migrate": "bun run src/infrastructure/postgres/migrate.ts",
    "start:api": "bun run src/api/main.ts",
    "start:worker": "bun run src/worker/main.ts"
  },
  "engines": {
    "bun": "1.3.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1115.0",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
