# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。

# --- PostgreSQL（切片 1 已用）---
DATABASE_URL=postgres://photo_agent:photo_agent@127.0.0.1:54329/photo_agent
PORT=3000

# --- 认证 ---
# 至少 32 字符；生产环境用 `openssl rand -base64 48` 生成
JWT_SECRET=

# --- 文本模型（Agent 大脑）---
# 必须同时支持 function calling 与图片输入
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-vision-exp

# --- 图像模型（中转站）---
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
# 不可为 auto：中转站内部会超时，边缘返回 502
IMAGE_SIZE=1024x1024
# img2img 路由。中转站当前 /images/edits 恒 502，只能走 chat；
# 供应商支持后改为 edits 即可切回标准格式
IMAGE_EDIT_ROUTE=chat

# --- 对象存储（开发用 MinIO，与 compose.yaml 一致）---
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=photo-agent
S3_ACCESS_KEY=photoagent
S3_SECRET_KEY=photoagent123
# 容器部署时:读写走内网端点,签名 URL 用浏览器可达端点(compose 已配好)
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# 前端跨域来源,生产收紧为具体域名
# CORS_ORIGIN=*
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=900

# --- 护栏与超时 ---
MAX_IMAGES_PER_TURN=3
IMAGE_TIMEOUT_MS=180000
TURN_TIMEOUT_MS=600000
TELEMETRY=stdout
