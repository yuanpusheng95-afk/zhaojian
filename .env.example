# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。

# --- PostgreSQL（切片 1 已用）---
DATABASE_URL=postgres://photo_agent:photo_agent@127.0.0.1:54329/photo_agent

# --- 文本模型（Agent 大脑）---
# 必须同时支持 function calling 与图片输入
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash-vision-exp

# --- 图像模型（中转站）---
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# --- 对象存储（开发用 MinIO，与 compose.yaml 一致）---
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=photo-agent
S3_ACCESS_KEY=photoagent
S3_SECRET_KEY=photoagent123
S3_REGION=us-east-1

# --- 护栏与超时 ---
MAX_IMAGES_PER_TURN=3
IMAGE_TIMEOUT_MS=180000
TURN_TIMEOUT_MS=600000
TELEMETRY=stdout
